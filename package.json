{
  "name": "pip",
  "version": "0.1.0",
  "description": "AI screen companion that watches, guides, and acts",
  "author": "Pip Team <support@pip.app>",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint src worker/src test *.ts",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "npm run typecheck:app && npm run typecheck:worker && npm run typecheck:test",
    "typecheck:app": "tsc --noEmit",
    "typecheck:worker": "tsc --noEmit -p worker/tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck:boundaries": "tsc --noEmit -p tsconfig.boundaries.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:all": "electron-builder --win --mac",
    "worker:dev": "cd worker && npx wrangler dev",
    "worker:deploy": "cd worker && npx wrangler deploy",
    "rebuild-native": "node-gyp rebuild --directory=native/accessibility-win"
  },
  "dependencies": {
    "electron-store": "^10.0.0",
    "uiohook-napi": "^1.5.5",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "miniflare": "^4.20260730.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
